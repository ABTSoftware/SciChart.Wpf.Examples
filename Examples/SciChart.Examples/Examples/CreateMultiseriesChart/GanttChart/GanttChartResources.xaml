<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="http://schemas.abtsoftware.co.uk/scichart"
                    xmlns:local="clr-namespace:SciChart.Examples.Examples.CreateMultiseriesChart.GanttChart">

    <!-- Discontinuous calendar that skips Saturday and Sunday.
         Used by both the header surface and the main chart X-axis so that weekends are
         compressed out of the timeline and only working days are visible. -->
    <local:WeekDaysAxisCalendar x:Key="XAxisCalendar" x:Shared="False"/>

    <!-- Base style for the DoubleScaleDiscontinuousDateTimeAxis.
         Major bands and axis-scale bands are disabled to keep the row backgrounds clean.
         Minor grid lines are hidden; major grid lines are drawn by the extended style below. -->
    <Style x:Key="DoubleScaleXAxisStyle" TargetType="s:DoubleScaleDiscontinuousDateTimeAxis">
        <Setter Property="GrowBy" Value="0.02,0.08"/>
        <Setter Property="AxisAlignment" Value="Top"/>
        <Setter Property="DrawMinorGridLines" Value="False"/>
        <Setter Property="DrawMajorBands" Value="False"/>
        <Setter Property="DrawAxisScaleBands" Value="False"/>
    </Style>

    <!-- Extended axis style used by the header surface (top row).
         Adds a bottom border, a matching background, and visible major grid lines so the
         header appears visually connected to the chart area below it. -->
    <Style x:Key="DoubleScaleXAxisWithGridLineStyle"
           BasedOn="{StaticResource DoubleScaleXAxisStyle}"
           TargetType="s:DoubleScaleDiscontinuousDateTimeAxis">
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{StaticResource MainThemeTransparentSolidBrush}"/>
        <Setter Property="Background" Value="{StaticResource ThemedChartBackground}"/>
        <Setter Property="MajorGridLineStyle">
            <Setter.Value>
                <Style TargetType="Line">
                    <Setter Property="Stroke" Value="{StaticResource MainThemeTransparentSolidBrush}"/>
                    <Setter Property="StrokeThickness" Value="1"/>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style for annotation labels placed on the X-axis (e.g. "Project End" and current-date
         labels). LabelPlacement=Axis positions the label directly on the axis tick.
         BorderThickness=0 and CornerRadius=0 give a flat rectangular appearance. -->
    <Style x:Key="XAxisLabelStyle" TargetType="s:AnnotationLabel">
        <Setter Property="Text" Value="{Binding FormattedLabel, Mode=OneWay}"/>
        <Setter Property="LabelPlacement" Value="Axis"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <!-- Panel template used for the left-axis panel of the main SciChartSurface.
         A single-column UniformGrid stacks the per-row Y-axes so they each occupy
         exactly the same height as the corresponding task item in the left list panel. -->
    <ItemsPanelTemplate x:Key="YAxesPanel">
        <UniformGrid Columns="1"/>
    </ItemsPanelTemplate>

    <!-- Y-axis style for individual task rows.
         Width=0 hides the axis from view while still contributing its MinHeight to the layout.
         VisibleRange="-0.2,1.2" adds padding above and below the stripe bar (which spans 0..1).
         AutoRange=Never prevents the range from being recalculated during pan/zoom.
         All ticks, labels, and grid lines are off — the axis is a layout row, not a scale. -->
    <Style x:Key="ItemYAxisStyle" TargetType="s:AxisBase">
        <Setter Property="Width" Value="0"/>
        <Setter Property="MinHeight" Value="75"/>
        <Setter Property="VisibleRange" Value="-0.2,1.2"/>
        <Setter Property="AutoRange" Value="Never"/>
        <Setter Property="DrawLabels" Value="False"/>
        <Setter Property="DrawMinorTicks" Value="False"/>
        <Setter Property="DrawMajorTicks" Value="False"/>
        <Setter Property="DrawMinorGridLines" Value="False"/>
        <Setter Property="DrawMajorGridLines" Value="False"/>
        <Setter Property="DrawMajorBands" Value="False"/>
        <!-- Exclude from MouseWheelZoomModifier so the row height stays fixed during zoom. -->
        <Setter Property="s:MouseWheelZoomModifier.IncludeAxis" Value="False"/>
    </Style>

    <!-- Hidden default right-aligned Y-axis. SciChart requires at least one right-aligned axis
         on a surface; this one is collapsed so it contributes nothing visually. -->
    <Style x:Key="DefaultYAxisStyle" TargetType="s:AxisBase">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="DrawLabels" Value="False"/>
        <Setter Property="DrawMinorTicks" Value="False"/>
        <Setter Property="DrawMajorTicks" Value="False"/>
        <Setter Property="DrawMinorGridLines" Value="False"/>
        <Setter Property="DrawMajorGridLines" Value="False"/>
        <Setter Property="DrawMajorBands" Value="False"/>
    </Style>

    <!-- Tooltip template for each stripe series, shown when the VerticalSliceModifier
         intersects a task bar. Displays the task's start (X) and end (X1) dates. -->
    <DataTemplate x:Key="ItemTooltipTemplate" DataType="s:StripeSeriesInfo">
        <StackPanel Orientation="Vertical">
            <TextBlock Foreground="White">
                <Run Text="Start:"/>
                <Run Text="{Binding FormattedXValue, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Foreground="White">
                <Run Text="End:"/>
                <Run Text="{Binding FormattedX1Value, Mode=OneWay}"/>
            </TextBlock>
        </StackPanel>
    </DataTemplate>

    <!-- Style applied to every FastStripeRenderableSeries (one per task row).
         - LabelColor/LabelFontSize: dark text drawn inside the stripe bar by GanttTextLabelProvider.
         - TooltipTemplate: shows start/end dates when the current-date marker crosses the bar.
         - TooltipContainerStyle: green rounded tooltip container matching the marker color.
         - RolloverMarkerTemplate: small green dot on the bar edge at the slice position. -->
    <Style x:Key="ItemRenderableSeriesStyle" TargetType="s:FastStripeRenderableSeriesForMvvm">
        <Setter Property="LabelColor" Value="#FF272727"/>
        <Setter Property="LabelFontSize" Value="13"/>
        <Setter Property="s:VerticalSliceModifier.TooltipTemplate" Value="{StaticResource ItemTooltipTemplate}"/>
        <Setter Property="s:VerticalSliceModifier.TooltipContainerStyle">
            <Setter.Value>
                <Style TargetType="s:TooltipControl">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="s:TooltipControl">
                                <Border Background="#FF42B649"
                                        CornerRadius="5"
                                        Opacity="0.9"
                                        Margin="0,0,5,5"
                                        Padding="5">

                                    <ContentPresenter Content="{TemplateBinding DataContext}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="RolloverMarkerTemplate">
            <Setter.Value>
                <ControlTemplate>
                    <Ellipse Width="10"
                             Height="10"
                             Fill="#FF42B649" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Custom ScrollViewer template used by the Gantt row area.
         Vertical scrolling (task list) is enabled; horizontal scrolling is suppressed because
         the X-axis range is controlled by ZoomPanModifier and the SciChartScrollbar below. -->
    <Style x:Key="ItemsScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid Background="{TemplateBinding Background}">
                        <ScrollContentPresenter />

                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Stretch"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>

                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                   VerticalAlignment="Bottom"
                                   HorizontalAlignment="Stretch"
                                   Orientation="Horizontal"
                                   Value="{TemplateBinding HorizontalOffset}"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thumb style shared by the custom vertical ScrollBar and the SciChartScrollbar. -->
    <Style x:Key="ScrollThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Height="Auto"
                            Width="Auto"
                            CornerRadius="4"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            BorderThickness="1"
                            BorderBrush="#FF151A25"
                            Background="#FF656D80"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit ScrollBar style applied to the vertical bar inside ItemsScrollViewerStyle.
         Minimal 9px width with a simple track-and-thumb template; arrow buttons are hidden. -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
        <Setter Property="Background" Value="#FF2B364C"/>
        <Setter Property="MinWidth" Value="9"/>
        <Setter Property="Width" Value="9"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid x:Name="GridRoot" Background="{TemplateBinding Background}">
                        <Border x:Name="BorderBackground" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Style="{DynamicResource ScrollThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="PageUp"
                                                  Opacity="0"
                                                  Focusable="False"
                                                  Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="PageDown"
                                                  Opacity="0"
                                                  Focusable="False"
                                                  Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Thumb" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style for the SciChartScrollbar docked at the bottom of the view.
         Compact 14px height; semi-transparent grey viewport fill; resize grips styled to match
         the thumb above; non-selected-area fill is transparent. -->
    <Style x:Key="SciChartScrollBarStyle" TargetType="s:SciChartScrollbar">
        <Setter Property="Height" Value="14"/>
        <Setter Property="GripsThickness" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="GripsStyle">
            <Setter.Value>
                <Style TargetType="s:ScrollbarResizeGrip">
                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="s:ScrollbarResizeGrip">
                                <Border x:Name="Thumb"
                                        Height="14"
                                        Width="8"
                                        CornerRadius="3"
                                        BorderThickness="1"
                                        BorderBrush="#FF151A25"
                                        Background="#FF656D80"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="ViewportStyle">
            <Setter.Value>
                <Style TargetType="Control">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Control">
                                <Border Background="#50656D80"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="NonSelectedAreaStyle">
            <Setter.Value>
                <Style TargetType="Path">
                    <Setter Property="Fill" Value="Transparent"/>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
