<UserControl x:Class="SciChart.Examples.Examples.PerformanceDemos2D.RacingTelemetryDashboard.Views.DomainChartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SciChart.Examples.Examples.PerformanceDemos2D.RacingTelemetryDashboard.Views" 
             xmlns:s="http://schemas.abtsoftware.co.uk/scichart">
    <UserControl.Resources>
        <s:ColorToBrushConverter x:Key="ColorToBrush" />
        <local:SeriesInfoValueConverter x:Key="SeriesInfoValueConverter" />

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A0C0E0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="LegendHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Margin" Value="4,8,4,4" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Legend column -->
        <Grid x:Name="legendPanel" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="LEGEND" Style="{StaticResource LegendHeader}" />

            <local:SelectionTrackingListBox Grid.Row="1"
                                 x:Name="legendItems"
                                 ItemsSource="{Binding DistanceChart.RenderableSeries}"
                                 SelectionMode="Extended"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Margin="4,0,4,0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingStackPanel.IsVirtualizing="False">
                <local:SelectionTrackingListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <!-- Strip default ListBoxItem chrome (blue highlight, focus rect) so the
                             custom selection visual on the inner Border is the only one shown. -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </local:SelectionTrackingListBox.ItemContainerStyle>
                <local:SelectionTrackingListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{Binding Stroke, Converter={StaticResource ColorToBrush}}" Padding="2" Margin="0,2,0,2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Background" Value="#18FFFFFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                <Rectangle Width="3" Height="32" Margin="0,0,5,0" Fill="{Binding Stroke, Converter={StaticResource ColorToBrush}}" />
                                <StackPanel>
                                    <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{Binding Stroke, Converter={StaticResource ColorToBrush}}" Text="{Binding DataSeries.SeriesName, Mode=OneWay}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="10" Foreground="{Binding Stroke, Converter={StaticResource ColorToBrush}}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource SeriesInfoValueConverter}" Mode="OneWay">
                                                    <Binding Path="DataSeries.SeriesName" />
                                                    <Binding ElementName="distSliceModifier" Path="SeriesData.SeriesInfo" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock FontSize="10" Margin="3,0,0,0" Foreground="{Binding Stroke, Converter={StaticResource ColorToBrush}}" Text="{Binding Tag, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </local:SelectionTrackingListBox.ItemTemplate>
            </local:SelectionTrackingListBox>
        </Grid>

        <!-- Vertical separator -->
        <Rectangle Grid.Column="1" Width="1" Fill="#405060" HorizontalAlignment="Center" />

        <!-- Distance + Time charts -->
        <Grid Grid.Column="2" Height="{Binding ActualHeight, ElementName=legendPanel}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="DISTANCE DOMAIN" Style="{StaticResource SectionHeader}" />

            <s:SciChartSurface x:Name="distSurface"
                               Grid.Row="1"
                               DataContext="{Binding DistanceChart}"
                               RenderableSeries="{s:SeriesBinding RenderableSeries}"
                               XAxes="{s:AxesBinding XAxes}"
                               YAxes="{s:AxesBinding YAxes}">
                <s:SciChartSurface.ChartModifier>
                    <s:ModifierGroup>
                        <s:RubberBandXyZoomModifier IsXAxisOnly="True" ExecuteOn="MouseLeftButton" />
                        <s:MouseWheelZoomModifier XyDirection="XDirection" />
                        <s:ZoomExtentsModifier ExecuteOn="MouseDoubleClick" />
                        <s:SeriesSelectionModifier ExecuteOn="MouseLeftButton" ReceiveHandledEvents="True" />
                        <s:VerticalSliceModifier x:Name="distSliceModifier" ShowTooltipOn="Never">
                            <s:VerticalSliceModifier.VerticalLines>
                                <s:VerticalLineAnnotation IsEditable="True"
                                                          DragDirections="XDirection"
                                                          ShowLabel="True"
                                                          XAxisId="DistX"
                                                          YAxisId="SliceY_Dist"
                                                          X1="{Binding SliceX, Mode=TwoWay}"
                                                          Stroke="White"
                                                          StrokeThickness="1"
                                                          StrokeDashArray="2,6,2"
                                                          LabelTextFormatting="F0" />
                            </s:VerticalSliceModifier.VerticalLines>
                        </s:VerticalSliceModifier>
                        <s:YAxisDragModifier />
                    </s:ModifierGroup>
                </s:SciChartSurface.ChartModifier>
            </s:SciChartSurface>

            <TextBlock Grid.Row="2" Text="TIME DOMAIN" Style="{StaticResource SectionHeader}" />

            <s:SciChartSurface x:Name="timeSurface"
                               Grid.Row="3"
                               DataContext="{Binding TimeChart}"
                               RenderableSeries="{s:SeriesBinding RenderableSeries}"
                               XAxes="{s:AxesBinding XAxes}"
                               YAxes="{s:AxesBinding YAxes}">
                <s:SciChartSurface.ChartModifier>
                    <s:ModifierGroup>
                        <s:RubberBandXyZoomModifier IsXAxisOnly="True" ExecuteOn="MouseLeftButton" />
                        <s:MouseWheelZoomModifier XyDirection="XDirection" />
                        <s:ZoomExtentsModifier ExecuteOn="MouseDoubleClick" />
                        <s:SeriesSelectionModifier ExecuteOn="MouseLeftButton" ReceiveHandledEvents="True" />
                        <s:VerticalSliceModifier ShowTooltipOn="Never">
                            <s:VerticalSliceModifier.VerticalLines>
                                <s:VerticalLineAnnotation IsEditable="True"
                                                          DragDirections="XDirection"
                                                          ShowLabel="True"
                                                          XAxisId="TimeX"
                                                          YAxisId="SliceY_Time"
                                                          X1="{Binding SliceX, Mode=TwoWay}"
                                                          Stroke="White"
                                                          StrokeThickness="1"
                                                          StrokeDashArray="2,6,2"
                                                          LabelTextFormatting="F1" />
                            </s:VerticalSliceModifier.VerticalLines>
                        </s:VerticalSliceModifier>
                        <s:YAxisDragModifier />
                    </s:ModifierGroup>
                </s:SciChartSurface.ChartModifier>
            </s:SciChartSurface>

        </Grid>
    </Grid>
</UserControl>
