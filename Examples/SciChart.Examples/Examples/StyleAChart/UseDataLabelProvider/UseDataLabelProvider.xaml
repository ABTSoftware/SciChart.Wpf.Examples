<UserControl x:Class="SciChart.Examples.Examples.StyleAChart.UseDataLabelProvider.UseDataLabelProvider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ext="http://schemas.abtsoftware.co.uk/scichart/exampleExternals"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://schemas.abtsoftware.co.uk/scichart"
             xmlns:annotations="clr-namespace:SciChart.Charting.Visuals.Annotations;assembly=SciChart.Charting"
             xmlns:dataLabelProviders="clr-namespace:SciChart.Charting.Visuals.RenderableSeries.DataLabelProviders;assembly=SciChart.Charting"
             xmlns:local="clr-namespace:SciChart.Examples.Examples.StyleAChart.UseDataLabelProvider"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             Loaded="OnLoaded"
             d:DesignHeight="400"
             d:DesignWidth="600"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ext:SciChartInteractionToolbar TargetSurface="{Binding Source={x:Reference Name=sciChart}}">
            
            <ext:FlyoutSeparator />

            <!-- Positioning -->
            <ext:FlyoutMenuButton x:Name="btnPositioning" ToolTipService.ToolTip="Positioning" IsEnabled="False">
                <ext:ToolbarIcon Kind="FormatVerticalAlignCenter" Style="{StaticResource ToolbarButtonIconStyle}"/>
                <ext:FlyoutMenuButton.PopupContent>
                    <StackPanel Margin="5" MinWidth="200" Orientation="Vertical">
                        <TextBlock Text="Positioning" Style="{StaticResource FlyoutMenuHeaderStyle}"/>

                        <TextBlock Text="Horizontal Anchor Point" Margin="0,6,0,2"/>
                        <ComboBox x:Name="cboHAlign" SelectedIndex="1" SelectionChanged="OnLabelOptionChanged">
                            <annotations:HorizontalAnchorPoint>Left</annotations:HorizontalAnchorPoint>
                            <annotations:HorizontalAnchorPoint>Center</annotations:HorizontalAnchorPoint>
                            <annotations:HorizontalAnchorPoint>Right</annotations:HorizontalAnchorPoint>
                        </ComboBox>

                        <TextBlock Text="Vertical Anchor Point" Margin="0,6,0,2"/>
                        <ComboBox x:Name="cboVAlign" SelectedIndex="0" SelectionChanged="OnLabelOptionChanged">
                            <annotations:VerticalAnchorPoint>Top</annotations:VerticalAnchorPoint>
                            <annotations:VerticalAnchorPoint>Center</annotations:VerticalAnchorPoint>
                            <annotations:VerticalAnchorPoint>Bottom</annotations:VerticalAnchorPoint>
                            <annotations:VerticalAnchorPoint>Auto</annotations:VerticalAnchorPoint>
                        </ComboBox>

                        <TextBlock x:Name="txtBarAnchor" Text="Bar Anchor Point" Margin="0,6,0,2" Visibility="Collapsed"/>
                        <ComboBox x:Name="cboBarAnchorPoint" SelectedIndex="0" Visibility="Collapsed" SelectionChanged="OnLabelOptionChanged">
                            <dataLabelProviders:BarAnchorPoint>Auto</dataLabelProviders:BarAnchorPoint>
                            <dataLabelProviders:BarAnchorPoint>Top</dataLabelProviders:BarAnchorPoint>
                            <dataLabelProviders:BarAnchorPoint>Bottom</dataLabelProviders:BarAnchorPoint>
                            <dataLabelProviders:BarAnchorPoint>Center</dataLabelProviders:BarAnchorPoint>
                        </ComboBox>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                            <TextBlock Text="Padding Left: "/>
                            <TextBlock Text="{Binding Value, ElementName=sliderMarginLeft, StringFormat={}{0:0}}"/>
                        </StackPanel>
                        <Slider x:Name="sliderMarginLeft" Minimum="-10" Maximum="20" Value="0"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="OnLabelOptionChanged"/>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <TextBlock Text="Padding Top: "/>
                            <TextBlock Text="{Binding Value, ElementName=sliderMarginTop, StringFormat={}{0:0}}"/>
                        </StackPanel>
                        <Slider x:Name="sliderMarginTop" Minimum="-10" Maximum="20" Value="3"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="OnLabelOptionChanged"/>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <TextBlock Text="Padding Right: "/>
                            <TextBlock Text="{Binding Value, ElementName=sliderMarginRight, StringFormat={}{0:0}}"/>
                        </StackPanel>
                        <Slider x:Name="sliderMarginRight" Minimum="-10" Maximum="20" Value="0"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="OnLabelOptionChanged"/>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <TextBlock Text="Padding Bottom: "/>
                            <TextBlock Text="{Binding Value, ElementName=sliderMarginBottom, StringFormat={}{0:0}}"/>
                        </StackPanel>
                        <Slider x:Name="sliderMarginBottom" Minimum="-10" Maximum="20" Value="3"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="OnLabelOptionChanged"/>
                    </StackPanel>
                </ext:FlyoutMenuButton.PopupContent>
            </ext:FlyoutMenuButton>

            <!-- Culling -->
            <ext:FlyoutMenuButton x:Name="btnCulling" ToolTipService.ToolTip="Culling" IsEnabled="False">
                <ext:ToolbarIcon Kind="FilterVariant" Style="{StaticResource ToolbarButtonIconStyle}"/>
                <ext:FlyoutMenuButton.PopupContent>
                    <StackPanel Margin="5" MinWidth="200" Orientation="Vertical">
                        <TextBlock Text="Culling" Style="{StaticResource FlyoutMenuHeaderStyle}"/>

                        <CheckBox x:Name="chkShowLabels" Content="Show Labels" Margin="0,8,0,2"
                                  Checked="OnLabelOptionChanged" Unchecked="OnLabelOptionChanged"/>

                        <TextBlock Text="Skip Mode" Margin="0,6,0,2"/>
                        <ComboBox x:Name="cboSkipMode" SelectedIndex="0" SelectionChanged="OnLabelOptionChanged">
                            <dataLabelProviders:DataLabelSkipMode>ShowAll</dataLabelProviders:DataLabelSkipMode>
                            <dataLabelProviders:DataLabelSkipMode>SkipIfOverlap</dataLabelProviders:DataLabelSkipMode>
                            <dataLabelProviders:DataLabelSkipMode>SkipIfSame</dataLabelProviders:DataLabelSkipMode>
                        </ComboBox>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <TextBlock Text="Skip Number: "/>
                            <TextBlock Text="{Binding Value, ElementName=sliderSkipNumber, StringFormat={}{0:0}}"/>
                        </StackPanel>
                        <Slider x:Name="sliderSkipNumber" Minimum="0" Maximum="10" Value="0"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="OnLabelOptionChanged"/>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <TextBlock Text="Point Count Threshold: "/>
                            <TextBlock Text="{Binding Value, ElementName=sliderThreshold, StringFormat={}{0:0}}"/>
                        </StackPanel>
                        <Slider x:Name="sliderThreshold" Minimum="10" Maximum="1000" Value="1000"
                                TickFrequency="10" IsSnapToTickEnabled="True"
                                ValueChanged="OnLabelOptionChanged"/>
                    </StackPanel>
                </ext:FlyoutMenuButton.PopupContent>
            </ext:FlyoutMenuButton>

            <!-- Text -->
            <ext:FlyoutMenuButton x:Name="btnText" ToolTipService.ToolTip="Text Options" IsEnabled="False">
                <ext:ToolbarIcon Kind="FormatFont" Style="{StaticResource ToolbarButtonIconStyle}"/>
                <ext:FlyoutMenuButton.PopupContent>
                    <StackPanel Margin="5" MinWidth="200" Orientation="Vertical">
                        <TextBlock Text="Text Options" Style="{StaticResource FlyoutMenuHeaderStyle}"/>

                        <TextBlock Text="Text Format (e.g. 0.##, N0, N2, E2, P1)" Margin="0,6,0,2"/>
                        <TextBox x:Name="txtNumericFormat" Text="0.##" TextChanged="OnLabelOptionChanged"/>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <TextBlock Text="Font Size: "/>
                            <TextBlock Text="{Binding Value, ElementName=sliderFontSize, StringFormat={}{0:0}}"/>
                        </StackPanel>
                        <Slider x:Name="sliderFontSize" Minimum="6" Maximum="28" Value="14"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="OnLabelOptionChanged"/>

                        <TextBlock Text="Label Color" Margin="0,6,0,2"/>
                        <ComboBox x:Name="cboColor" SelectedIndex="0" SelectionChanged="OnLabelOptionChanged">
                            <system:String>White</system:String>
                            <system:String>Yellow</system:String>
                            <system:String>LimeGreen</system:String>
                            <system:String>Cyan</system:String>
                            <system:String>Black</system:String>
                        </ComboBox>
                    </StackPanel>
                </ext:FlyoutMenuButton.PopupContent>
            </ext:FlyoutMenuButton>

        </ext:SciChartInteractionToolbar>

        <s:SciChartSurface x:Name="sciChart"
                           Grid.Column="1"
                           BorderThickness="0"
                           Padding="0">

            <s:SciChartSurface.XAxis>
                <s:NumericAxis GrowBy="0.025, 0.025"/>
            </s:SciChartSurface.XAxis>

            <s:SciChartSurface.YAxis>
                <s:NumericAxis GrowBy="0.05, 0.05"/>
            </s:SciChartSurface.YAxis>

            <s:SciChartSurface.RenderableSeries>
                <s:FastColumnRenderableSeries x:Name="columnSeries"
                                              Fill="#AA4783D4"
                                              Stroke="#4783D4"
                                              DataPointWidth="0.6"
                                              ShowDataLabels="True">
                    <s:FastColumnRenderableSeries.DataLabelProvider>
                        <local:ColoredColumnDataLabelProvider />
                    </s:FastColumnRenderableSeries.DataLabelProvider>
                </s:FastColumnRenderableSeries>

                <s:FastLineRenderableSeries x:Name="lineSeries"
                                            Stroke="#50C7E0"
                                            StrokeThickness="2"
                                            ShowDataLabels="True"
                                            FontSize="14"
                                            Foreground="Cyan">
                    <s:FastLineRenderableSeries.DataLabelProvider>
                        <dataLabelProviders:PointDataLabelProvider LabelVerticalAnchorPoint="Top" />
                    </s:FastLineRenderableSeries.DataLabelProvider>
                </s:FastLineRenderableSeries>

                <s:FastBubbleRenderableSeries x:Name="bubbleSeries"
                                              AutoZRange="True"
                                              MaxBubbleSizeInPixels="80"
                                              ZScaleFactor="1.0"
                                              BubbleColor="#77AA4CFC"
                                              Stroke="#AA4CFC"
                                              StrokeThickness="1"
                                              ShowDataLabels="True"
                                              Foreground="White">
                    <s:FastBubbleRenderableSeries.SelectedSeriesStyle>
                        <Style TargetType="s:FastBubbleRenderableSeries">
                            <Setter Property="StrokeThickness" Value="3"/>
                            <Setter Property="Stroke" Value="White"/>
                            <Setter Property="BubbleColor" Value="#AAAA4CFC"/>
                        </Style>
                    </s:FastBubbleRenderableSeries.SelectedSeriesStyle>
                </s:FastBubbleRenderableSeries>

                <s:FastLineRenderableSeries x:Name="splineSeries"
                                            Stroke="#68BCA0"
                                            StrokeThickness="2"
                                            ShowDataLabels="True"
                                            FontSize="14"
                                            Foreground="LimeGreen">
                </s:FastLineRenderableSeries>
            </s:SciChartSurface.RenderableSeries>

            <s:SciChartSurface.ChartModifier>
                <s:ModifierGroup>
                    <s:SeriesSelectionModifier x:Name="seriesSelectionModifier" SelectionChanged="OnSeriesSelectionChanged">
                        <s:SeriesSelectionModifier.SelectedSeriesStyle>
                            <Style TargetType="s:BaseRenderableSeries">
                                <Setter Property="StrokeThickness" Value="5"/>
                            </Style>
                        </s:SeriesSelectionModifier.SelectedSeriesStyle>
                    </s:SeriesSelectionModifier>
                    <s:ZoomPanModifier />
                    <s:ZoomExtentsModifier/>
                    <s:MouseWheelZoomModifier/>
                    <s:LegendModifier ShowLegend="True" Margin="10" 
                                      ext:SciChartInteractionToolbar.AppearsInToolbar="False" />
                </s:ModifierGroup>
            </s:SciChartSurface.ChartModifier>

        </s:SciChartSurface>
    </Grid>
</UserControl>
